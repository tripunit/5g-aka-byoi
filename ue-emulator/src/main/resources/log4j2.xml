<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="warn">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d [%t] %p %c - %m%n"/>
        </Console>
        <RollingFile
            name           = "RollingFile"
            createOnDemand = "true"
            fileName       = "/var/log/5g-aka-byoi/ue-emulator/ue-emulator.log"
            filePattern    = "/var/log/5g-aka-byoi/ue-emulator/ue-emulator-%d{MM-dd-yyyy}-%i.log.gz">
            <PatternLayout pattern="%d [%t] %p %c - %m%n"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="20 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="20"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger
            name       = "ca.uwaterloo.fivegakabyoi.ueemulator"
            level      = "${sys:ueemulator.loglevel:-warn}"
            additivity = "false">
            <AppenderRef ref="RollingFile"/>
        </Logger>
        <Root level="warn">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
